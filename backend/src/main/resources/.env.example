# =============================================================================
# DriveEase - backend environment variables (copy to .env / set in your host)
# NEVER commit a real .env file.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Local:  jdbc:postgresql://localhost:5432/driveease
# Cloud:  jdbc:postgresql://<host>:5432/<db>?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/driveease
DB_USERNAME=postgres
DB_PASSWORD=replace-with-local-password
DB_POOL_SIZE=20
DB_POOL_MIN_IDLE=5

# --- JWT / security ---------------------------------------------------------
# Generate with: openssl rand -base64 48   (minimum 32 bytes for HS256)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800
PASSWORD_RESET_EXPIRATION=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# --- Front-end / CORS -------------------------------------------------------
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# --- Business configuration -------------------------------------------------
BOOKING_MAX_ADVANCE_DAYS=180
BOOKING_MAX_RENTAL_DAYS=60
PAYMENT_GATEWAY_MODE=SANDBOX
PAYMENT_REFERENCE_PREFIX=DE-TXN

# --- Email ------------------------------------------------------------------
# mock = logs the rendered email to the application log (default, free, no provider)
# smtp = real delivery, requires the SMTP_* values below
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@driveease.app
EMAIL_FROM_NAME=DriveEase
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Runtime ----------------------------------------------------------------
SERVER_PORT=8080
SEED_DEMO_DATA=false
SPRING_PROFILES_ACTIVE=dev
