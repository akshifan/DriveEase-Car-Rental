# =============================================================================
# DriveEase - backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit the resulting .env file.
# =============================================================================

# ── Database ───────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/driveease
DB_USERNAME=driveease_user
DB_PASSWORD=change-me
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# ── Security ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=1209600
PASSWORD_RESET_EXPIRATION=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# ── CORS / URLs ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# ── Payments (sandbox gateway - moves no real money) ───────────
PAYMENT_GATEWAY_MODE=SANDBOX
PAYMENT_FAILURE_THRESHOLD=100000.00

# ── Email ──────────────────────────────────────────────────────
# mock = log the rendered email to the application log (default, no provider)
# smtp = real delivery, requires the SMTP_* values below
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@driveease.app
EMAIL_FROM_NAME=DriveEase
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Demo data (dev/demo databases only) ────────────────────────
SEED_DEMO_DATA=false
