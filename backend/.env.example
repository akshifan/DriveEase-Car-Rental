# DriveEase backend - example environment (copy to .env and fill in; never commit real values)

# ── Database ──────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/driveease
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# ── Security (REQUIRED in production - no defaults there) ────
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=1209600
PASSWORD_RESET_EXPIRATION=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=

# ── CORS / URLs ───────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:8080

# ── Payments (sandbox gateway - moves no real money) ──────────
PAYMENT_GATEWAY_MODE=SANDBOX
PAYMENT_FAILURE_THRESHOLD=100000.00

# ── Email (mock provider logs instead of sending in dev) ──────
EMAIL_PROVIDER=mock
EMAIL_FROM=no-reply@driveease.app
EMAIL_FROM_NAME=DriveEase

# ── Demo data (dev/demo databases only) ───────────────────────
SEED_DEMO_DATA=true

