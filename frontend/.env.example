# Base URL of the DriveEase API.
# Leave empty in development: the Vite dev server proxies /api to the backend.
# In production set it to the deployed API origin, e.g. https://driveease-api.onrender.com
VITE_API_BASE_URL=

# Where the Vite dev-server proxy forwards /api (defaults to http://localhost:8080)
VITE_DEV_API_TARGET=http://localhost:8080
