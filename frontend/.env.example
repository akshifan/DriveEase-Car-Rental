# DriveEase frontend — local environment template.
# Copy to `.env` and adjust; never commit the real `.env`.

# Base URL for the API. Leave empty in local dev to use the Vite proxy (see vite.config.js).
# In production point this at the deployed backend origin, e.g. https://api.driveease.app
VITE_API_BASE_URL=http://localhost:8080

# Real GLB/GLTF 3D car for the hero. Must be a path served by Vite (i.e. under /public).
# When unset or missing, CarModel falls back to the bundled procedural car.
VITE_CAR_MODEL_URL=/models/driveease-car.glb
